{
  "name": "@z-ui/monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "description": "A lightweight Vue 3 component library for TypeScript projects.",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C play dev",
    "build": "pnpm run typecheck && vite build && sass packages/theme-chalk/src/index.scss packages/z-ui/dist/style.css --no-source-map",
    "build:types": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.vue,.js",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "docs:preview": "pnpm -C docs preview",
    "pack:check": "pnpm --filter @xch-jjay/z-ui pack:check",
    "package:lint": "publint packages/z-ui",
    "package:types": "attw --pack packages/z-ui --exclude-entrypoints style.css package.json",
    "package:consumer": "node scripts/consumer-smoke.mjs",
    "package:ssr": "node scripts/ssr-smoke.mjs",
    "package:size": "node scripts/package-size.mjs",
    "package:check": "pnpm pack:check && pnpm package:lint && pnpm package:types && pnpm package:consumer && pnpm package:ssr && pnpm package:size",
    "clean": "node -e \"fs.rmSync('packages/z-ui/dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "vue3",
    "vue",
    "typescript",
    "component-library",
    "ui"
  ],
  "author": "xch-jjay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xch-jjay/x-norpr-ui.git"
  },
  "bugs": {
    "url": "https://github.com/xch-jjay/x-norpr-ui/issues"
  },
  "homepage": "https://github.com/xch-jjay/x-norpr-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^9.6.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitest/coverage-v8": "2.0.5",
    "@vue/language-core": "3.3.11",
    "@vue/test-utils": "^2.4.6",
    "@z-ui/components": "workspace:*",
    "@z-ui/theme-chalk": "workspace:*",
    "@z-ui/utils": "workspace:*",
    "eslint": "^9.6.0",
    "eslint-plugin-vue": "^9.27.0",
    "globals": "^15.8.0",
    "jsdom": "^24.1.1",
    "publint": "0.3.24",
    "sass": "^1.77.7",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.16.0",
    "unplugin-dts": "1.1.0",
    "vite": "^5.3.1",
    "vitest": "^2.0.5",
    "vue": "^3.4.31",
    "vue-tsc": "^2.0.21"
  }
}
