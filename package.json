{
  "name": "z-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "description": "A lightweight Vue 3 component library for TypeScript projects.",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C play dev",
    "build": "pnpm run typecheck && vite build && node scripts/copy-types.mjs && sass packages/theme-chalk/src/index.scss packages/z-ui/dist/style.css --no-source-map",
    "build:types": "pnpm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.vue,.js",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "docs:preview": "pnpm -C docs preview",
    "pack:check": "pnpm --filter z-ui pack:check",
    "clean": "node -e \"fs.rmSync('packages/z-ui/dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "vue3",
    "vue",
    "typescript",
    "component-library",
    "ui"
  ],
  "author": "xch-jjay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xch-jjay/x-norpr-ui.git"
  },
  "bugs": {
    "url": "https://github.com/xch-jjay/x-norpr-ui/issues"
  },
  "homepage": "https://github.com/xch-jjay/x-norpr-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "@types/node": "^22.10.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.6.0",
    "jsdom": "^24.1.1",
    "sass": "^1.77.7",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "vitest": "^2.0.5",
    "vue": "^3.4.31",
    "vue-tsc": "^2.0.21",
    "@z-ui/components": "workspace:*",
    "@z-ui/theme-chalk": "workspace:*",
    "@z-ui/utils": "workspace:*"
  }
}
